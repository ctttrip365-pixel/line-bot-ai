{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/dispatch/notify-tomorrow",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/dispatch/refresh-day-status",
      "schedule": "0 23 * * *"
    }
  ]
}
